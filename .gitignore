# colcon ワークスペースのビルド成果物
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
__pycache__/
*.pyc

# エディタ・OSが生成する一時ファイル(Mac/Ubuntu両対応で開発しているため)
.DS_Store
*.swp
*.swo
*~
.vscode/
.idea/

# Obsidian: ウィンドウ状態などローカル限定の情報。共有設定(appearance/core-plugins等)は追跡する
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# 環境固有のcompose上書き(例: /dev/driが無い環境でのGPU渡し無効化)。ローカル限定
docker/compose.override.yaml
docker/sim/compose.override.yaml

# GATE1計測の生ログ(CSV)。集計結果はREADMEに要約を記載するのでローカル限定
ros2_ws/src/go2_path_following/scripts/results/

# inspect_run.py の実行ログ(inspect_*.log)。実行するたびに生成されるのでローカル限定
tools/logs/

# 実機SLAM調査(#13)のrosbag録画・再生データ(数GB規模)と、検証中に作った実験用地図。
# いずれも手元での切り分け作業の産物でローカル限定
ros2_ws/bags/
ros2_ws/map_real_*.pgm
ros2_ws/map_real_*.yaml

# scanmatcher_gap_watchdog.pyがギャップ検知時に書く合図ファイル(実行時に生成・更新される
# だけのランタイム成果物。capture_on_gap.shがこれを監視する)
ros2_ws/src/go2_localization/scripts/.gap_trigger
