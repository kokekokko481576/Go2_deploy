<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>go2_bt_plugins</name>
  <version>0.1.0</version>
  <description>
    経路追従BT(#23派生)用のカスタムBehaviorTree.CPPプラグイン。collision_detector(#23)の
    collision_detectedトピックをBT条件ノード(IsCollisionDetected)として公開し、
    衝突時にFollowPathを止めてリカバリへ落とす判断をBT XML側に持たせる。
  </description>
  <maintainer email="koga_koichiro@naoe.eng.osaka-u.ac.jp">koga_koichiro</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>behaviortree_cpp_v3</depend>
  <depend>nav2_behavior_tree</depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
